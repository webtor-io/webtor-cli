# The interactive screens, driven through the numbered fallback:
# WEBTOR_FORCE_INTERACTIVE turns the menus on without a TTY, piped answers
# steer them.
env WEBTOR_BACKEND=direct WEBTOR_BASE_URL=$RESTAPI_URL WEBTOR_FORCE_INTERACTIVE=1

# `webtor <resource-id>` opens the resource menu; "1" = play (the default
# first action), then "q" quits the menu loop (silent exit 1).
stdin play_then_quit.txt
! webtor 08ada5a7a6183aae1e09d831df6748d566095a10 --player true
stderr 'launched true: Sintel/Sintel.mkv'

# "b" backs out of the menu without doing anything: clean exit 0
stdin back.txt
webtor 08ada5a7a6183aae1e09d831df6748d566095a10 --player true
! stderr 'launched'

# the resource menu on a rest-api backend has no library/vault entries
stdin back.txt
webtor 08ada5a7a6183aae1e09d831df6748d566095a10
! stderr 'library'
! stderr 'vault'
stderr 'browse files'

# browse: the wrapper directory Sintel/ is skipped, so the first screen
# already lists the files; pick the second (poster.jpg), download it, quit
stdin browse.txt
! webtor 08ada5a7a6183aae1e09d831df6748d566095a10 --player true
stderr 'poster.jpg:'
exists poster.jpg

# default download folder: no -o, WEBTOR_DOWNLOAD_DIR takes it, layout kept
env WEBTOR_DOWNLOAD_DIR=$WORK/dl_default
webtor -q download 08ada5a7a6183aae1e09d831df6748d566095a10
exists dl_default/Sintel/Sintel.mkv
exists dl_default/Sintel/poster.jpg

# local-first playback: the file above is complete on disk, so play uses it
webtor play 08ada5a7a6183aae1e09d831df6748d566095a10 /Sintel/Sintel.mkv --player true
stderr 'playing from disk'
stderr 'dl_default'
env WEBTOR_DOWNLOAD_DIR=

# library toggles in the browser: switching the section relists with the
# new title (webui dialect needed for the library surface)
env WEBTOR_BACKEND=webui WEBTOR_BASE_URL=$WEBUI_URL WEBTOR_API_KEY=$VALID_KEY
webtor library add 08ada5a7a6183aae1e09d831df6748d566095a10
stdin toggles.txt
! webtor library
stderr 'Library \(all, recent\):'
stderr 'Library \(movies, recent\):'
stderr 'Library \(movies, name\):'
env WEBTOR_BACKEND=direct WEBTOR_BASE_URL=$RESTAPI_URL WEBTOR_API_KEY=

# scripted (no force flag): `webtor <id>` prints the descriptor
env WEBTOR_FORCE_INTERACTIVE=
webtor 08ada5a7a6183aae1e09d831df6748d566095a10
stdout 'Sintel'

# unknown command still errors
! webtor definitely-not-a-command
stderr 'unknown command'

-- play_then_quit.txt --
1
q
-- back.txt --
b
-- toggles.txt --
1
2
q
-- browse.txt --
2
2
2
q
